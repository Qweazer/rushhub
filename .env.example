# GoRush 运行时配置示例。
# 复制为 .env 后按需修改；.env 不进 git。

# --- HTTP 服务 ---
SERVER_PORT=18080

# --- MySQL（对应 docker-compose.yml）---
# 主机端口走 13306，避免和本机已有 MySQL 冲突。
DB_HOST=127.0.0.1
DB_PORT=13306
DB_USER=gorush
DB_PASSWORD=gorushpass
DB_NAME=gorush

# --- Redis（对应 docker-compose.yml）---
REDIS_ADDR=127.0.0.1:16379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TIMEOUT_MS=200

# docker-compose.yml 内部使用的 root 密码（启动容器时读取）。
MYSQL_ROOT_PASSWORD=rootpass
